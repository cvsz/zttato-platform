APP_ENV=development
APP_BASE_URL=http://localhost:8000
APP_ALLOWED_HOSTS=localhost,127.0.0.1,zttato.zeaz.dev
DATABASE_URL=sqlite:///./data/zttato.db
APP_ENCRYPTION_KEY=REPLACE_WITH_FERNET_GENERATED_KEY
TIKTOK_CLIENT_KEY=REPLACE_IN_LOCAL_ENV_ONLY
TIKTOK_CLIENT_SECRET=REPLACE_IN_LOCAL_ENV_ONLY
TIKTOK_SCOPES=user.info.basic,video.upload,video.publish
TIKTOK_APP_AUDITED=false
# Optional; Photo Post stays disabled until TikTok verifies these HTTPS URL prefixes.
TIKTOK_VERIFIED_MEDIA_URL_PREFIXES=
LEGAL_ENTITY=REPLACE_WITH_REGISTERED_OPERATOR
LEGAL_CONTACT_EMAIL=REPLACE_WITH_REAL_SUPPORT_EMAIL
LEGAL_POSTAL_ADDRESS=REPLACE_WITH_REAL_POSTAL_ADDRESS
MEDIA_DIR=./media
MAX_VIDEO_BYTES=67108864
MAX_REQUESTS_PER_MINUTE=120
MAX_UPLOADS_PER_DAY=10
MAX_UPLOAD_BYTES_PER_DAY=268435456
MEDIA_RETENTION_DAYS=30
RECORD_RETENTION_DAYS=90
CLEANUP_INTERVAL_SECONDS=3600
PUBLISH_WORKER_INTERVAL_SECONDS=2
# Optional; without a value the private /metrics endpoint is disabled.
METRICS_BEARER_TOKEN=

# Optional server-side invoice-intent integration. Leave both empty to keep it disabled.
ZWALLET_ADAPTER_URL=
Z_PLATFORM_SERVICE_TOKEN=

# Required for docker compose; generate a unique random value locally.
POSTGRES_PASSWORD=REPLACE_WITH_UNIQUE_DB_PASSWORD
